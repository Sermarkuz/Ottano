<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Ottano" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowSplashScreenBackground">@color/ottano_dark</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="android:postSplashScreenTheme">@style/Theme.Ottano.PostSplash</item>
    </style>
    <style name="Theme.Ottano.PostSplash" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/ottano_dark</item>
        <item name="android:navigationBarColor">@color/ottano_dark</item>
        <item name="android:statusBarColor">@color/ottano_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:colorAccent">@color/ottano_gold</item>
    </style>
</resources>
